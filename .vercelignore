# Vercel Deployment Ignore

# Source control & IDEs
.github/
.vscode/
.pytest_cache/
.agents/
.gemini/

# Development & Test Suites
scratch/
scripts/
!scripts/build.js
seo/
tests/
monitoring_output/

# Content Drafts & Admin CMS
content/
templates/
blog/_template.html

# Dependencies & Package Managers
node_modules/
# package.json (needed for build)
!package.json
package-lock.json
requirements*.txt

# Documentation & Markdown
docs/
*.md
!llms.txt
!llms-full.txt

# Source Scripts, Data & Backups
*.py
*.csv
*.psd
*.zip
*.bak
*.log
PUBLIC_URL.txt

# Non-runtime JSON (keep vercel.json)
*.json
!vercel.json
!data/**
!site.webmanifest

# Image Originals, Archives, and Screenshot Folders
images/**/originals/
images/**/originals/**
images/**/archive/
images/**/archive/**
screenshots/
**/screenshots/
**/screenshots/**

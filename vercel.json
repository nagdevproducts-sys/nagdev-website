    },
    {
      "source": "/guides/castor-oil-vs-other-vegetable-oils-for-lubricants",
      "destination": "/compare/castor-oil-vs-other-vegetable-oils",
      "permanent": true
    },
    {
      "source": "/guides/castor-oil-export-packing-incoterms",
      "destination": "/guides/castor-oil-packaging-and-storage",
      "permanent": true
    },
    {
      "source": "/products/de-oiled-cake-castor-meal",
      "destination": "/products/castor-cake",
      "permanent": true
    },
    {
      "source": "/products/de-oiled-cake-castor-meal.html",
      "destination": "/products/castor-cake",
      "permanent": true
    },
    {
      "source": "/blog/bio-based-polyurethane-polyols-castor-oil",
      "destination": "/castor-oil-derivatives",
      "permanent": true
    },
    {
      "source": "/blog/bio-based-polyurethane-polyols-castor-oil.html",
      "destination": "/castor-oil-derivatives",
      "permanent": true
    },
    {
      "source": "/blog/dehydrated-castor-oil-alkyd-resins-coatings",
      "destination": "/blog/dehydrated-castor-oil-technical-guide",
      "permanent": true
    },
    {
      "source": "/blog/dehydrated-castor-oil-alkyd-resins-coatings.html",
      "destination": "/blog/dehydrated-castor-oil-technical-guide",
      "permanent": true
    },
    {
      "source": "/blog/hydrogenated-castor-oil-12-hsa-lithium-greases",
      "destination": "/blog/hydrogenated-castor-oil-bulk-supply-gujarat",
      "permanent": true
    },
    {
      "source": "/blog/hydrogenated-castor-oil-12-hsa-lithium-greases.html",
      "destination": "/blog/hydrogenated-castor-oil-bulk-supply-gujarat",
      "permanent": true
    },
    {
      "source": "/blog/sustainable-castor-oil-derivatives-green-chemistry",
      "destination": "/castor-oil-derivatives",

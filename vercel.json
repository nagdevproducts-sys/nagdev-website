      "permanent": true
    },
    {
      "source": "/products/castor-cake-fertilizer.html",
      "destination": "/products/castor-cake",
      "permanent": true
    },
    {
      "source": "/guides/hco-vs-12-hsa",
      "destination": "/compare/hco-vs-12-hsa",
      "permanent": true
    },
    {
      "source": "/guides/castor-wax-vs-paraffin-wax",

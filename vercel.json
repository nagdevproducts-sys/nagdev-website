      "permanent": true
    },
    {
      "source": "/factory-setup/",
      "destination": "/plant",
      "permanent": true
    },
    {
      "source": "/factory-setup",
      "destination": "/plant",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {

{
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!.github' ':!tests'",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "wc-ajax"
        }
      ],
      "destination": "/api/gone"
    },
    {
      "source": "/product/rye",
      "destination": "/api/gone"
    },
    {
      "source": "/product/coriander-seeds",
      "destination": "/api/gone"
    },
    {
      "source": "/product/dried-peas",
      "destination": "/api/gone"
    },
    {
      "source": "/product/rice",
      "destination": "/api/gone"
    },
    {
      "source": "/product/millet-bajra",
      "destination": "/api/gone"
    },
    {
      "source": "/product/nuts",
      "destination": "/api/gone"
    },
    {
      "source": "/product-category/:slug*",
      "destination": "/api/gone"
    },
    {
      "source": "/product/:slug*",
      "destination": "/api/gone"
    }
  ],
  "redirects": [
